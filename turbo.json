{
  "$schema": "https://turborepo.com/schema.json",
  "globalEnv": ["LAIF_DEMO_*", "VITE_LAIF_*", "EXPO_PUBLIC_LAIF_*"],
  "tasks": {
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "lint": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^typecheck"],
      "outputs": ["coverage/**"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test:e2e": {
      "cache": false
    },
    "test:maestro": {
      "cache": false
    }
  }
}
