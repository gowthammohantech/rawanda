{
  "name": "laif-careconnect",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:clinical": "turbo run dev --filter=@laif/clinical-web",
    "dev:admin": "turbo run dev --filter=@laif/programme-admin",
    "dev:worker": "pnpm --filter @laif/worker-mobile start",
    "dev:citizen": "pnpm --filter @laif/citizen-wallet start",
    "typecheck": "turbo run typecheck && tsc -p scripts",
    "lint": "turbo run lint && pnpm lint:root && prettier --check .",
    "lint:root": "eslint eslint.config.js vitest.config.ts scripts && tsx scripts/check-dep-graph.ts",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "turbo run build",
    "test:e2e": "turbo run test:e2e",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "9.39.5",
    "eslint-plugin-i18next": "6.1.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tsx": "4.23.15",
    "turbo": "2.11.8",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vitest": "3.2.7"
  }
}
